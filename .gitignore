h3pipeline/app/h3-setup.zip

# cola y modo libre
h3pipeline/app/cola.json
mis-videos/_libre/

RENDER-VARIABLES.txt

# estado de la máquina y la cola (mis-videos/_estado, disco persistente)
mis-videos/_estado/

# biblioteca de música de los music videos (pistas, piezas)
mis-videos/_musica/

# editar: videos subidos, hojas, clips
mis-videos/_editar/

# ── remasterizado (18/9): el máster de 22 GB, las entregas y las descargas a medias
remasterizado/original/
remasterizado/ENTREGA-*/
*.part
*.mxf
mis-videos/_remaster/

# El banco de voces de fábrica (presets para Ref2VA) viaja con el código
!h3pipeline/voces/*.wav
