# ── secretos ───────────────────────────────────────────────────────────────
.env
.env.*
*.pem.key
credentials*.json

# ── entornos y cachés ──────────────────────────────────────────────────────
.venv*/
venv/
__pycache__/
*.pyc
.claude/
node_modules/

# ── modelos (196 GB) ───────────────────────────────────────────────────────
models/
Minimax h3/
*.gguf
*.safetensors
*.ckpt

